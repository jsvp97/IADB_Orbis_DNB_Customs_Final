# ============================================================
# .gitignore — orbis-dnb-customs-trade
# ============================================================
# Data files are NOT tracked. Raw and intermediate data contain
# proprietary (Orbis, DNB) and restricted (customs) information.
# ============================================================

# Stata data files
*.dta
*.ster

# Stata log and output files
*.log
*.smcl

# Excel and CSV output files
*.xlsx
*.xls
*.csv

# Stata graph files
*.gph

# Python bytecode and cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Python virtual environment
.venv/
env/
venv/

# Jupyter notebooks (contain output data)
*.ipynb

# NMSLIB index files
*.bin

# Pickle files (intermediate ML objects)
*.pkl
*.pickle

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Editor files
.vscode/
.idea/
*.swp
*.swo

# Output folder (generated — do not commit)
output/

# Overleaf sync folder
overleaf/

# Agro output
agro/Output/

# ============================================================
# EXCEPTIONS — files that SHOULD be tracked despite extensions
# ============================================================

# The data README describes data structure without containing data
!data/README.md

# ============================================================
# Added 2026-09-03 (reorganisation for the stylized-facts WP)
# ============================================================
# Legacy material and the old nested clone -- provenance only
archive/
# Parquet caches (stylized-facts pipeline) and any local data samples
*.parquet
data/samples/
# Large binary docs that are not our own text
docs/agro/*.pdf
# Local Overleaf stand-in
output/overleaf_mirror/

# Overleaf upload zips (rebuilt by stylized_facts/python/wp_export_overleaf.py)
docs/overleaf_projects/*.zip

# External downloads (2026-11-02): large or redistribution-restricted; see data/raw/external/README.md
data/raw/external/*
!data/raw/external/README.md

# UNSD correspondence tables, downloaded 2026-11-03
data/raw/unsd/

# LaTeX build files in the Overleaf mirrors (2026-11-23); the distributed PDF lives in docs/
docs/overleaf_projects/**/*.aux
docs/overleaf_projects/**/*.out
docs/overleaf_projects/**/*.spl
docs/overleaf_projects/**/*.toc
docs/overleaf_projects/WP_paperagro/Note_v*.pdf

# Zips of deliveries and figure folders (2026-11-28): rebuilt from the tracked files, shared by hand
docs/notes/*.zip
